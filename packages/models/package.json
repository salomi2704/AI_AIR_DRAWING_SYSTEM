// package.json for packages/models
{
  "name": "@ai-air-drawing/models",
  "version": "1.0.0",
  "description": "AI model registry and management for AI Air Drawing System - Central registry for all AI/ML models and inference providers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/post-build.cjs",
    "build:clean": "rimraf dist",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --strict",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "semantic-release": "semantic-release",
    "prepare": "husky install"
  },
  "dependencies": {
    "@ai-air-drawing/core": "^1.0.0",
    "onnxruntime-node": "^1.20.0",
    "node-fetch": "^3.3.2",
    "form-data": "^4.0.0",
    "redis": "^4.6.0",
    "@tensorflow/tfjs-node": "^4.7.0",
    "ml-matrix": "^6.11.0",
    "uuid": "^9.0.1",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/node-fetch": "^2.6.0",
    "@types/redis": "^2.8.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "@types/jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "semantic-release": "^22.0.0",
    "@types/validator": "^13.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
      "dist/**/*",
      "README.md",
      "CHANGELOG.md"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:your-org/ai-air-drawing.git",
    "directory": "packages/models"
  },
  "keywords": [
    "ai",
    "models",
    "registry",
    "inference",
    "tensorflow",
    "onnx",
    "model-management",
    "ml",
    "ai-models"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-org/ai-air-drawing/issues",
    "email": "support@ai-air-drawing.com"
  },

}