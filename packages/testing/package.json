// package.json for packages/testing
{
  "name": "@ai-air-drawing/testing",
  "version": "1.0.0",
  "description": "Testing framework and CI/CD for AI Air Drawing System - Unit tests, integration tests, and performance benchmarking",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "types": "./src/index.ts",
    "default": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/post-build.cjs",
    "build:clean": "rimraf dist",
    "dev": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:integration": "jest --testPathPattern=integration",
    "test:performance": "jest --testPathPattern=performance",
    "test:ui": "jest --testPathPattern=ui",
    "test:accessibility": "jest --testPathPattern=accessibility",
    "lint": "eslint src --fix",
    "lint:check": "eslint src",
    "typecheck": "tsc --noEmit",
    "typecheck:strict": "tsc --noEmit --strict",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "semantic-release": "semantic-release",
    "prepare": "husky install",
    "test:all": "jest --collectCoverageFrom='<rootDir>/src/**/*.{js,ts}' --coverage",
    "test:coverage": "jest --coverage",
    "test:report": "jest --coverage --coverageReporters=html,json,lcov",
    "benchmark": "node benchmarks/run-benchmarks.cjs",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test:e2e": "start-server-and-test start test/server.js 'http://localhost:3000' cypress/run",
    "test:all-environments": "npm run test:unit && npm run test:integration && npm run test:performance && npm run test:e2e"
  },
  "dependencies": {
    "@ai-air-drawing/core": "^1.0.0",
    "jest": "^29.0.0",
    "jest-html-reporters": "^3.1.0",
    "jest-junit": "^2.0.0",
    "jest-json-report": "^2.0.0",
    "supertest": "^7.0.0",
    "cross-fetch": "^4.0.0",
    "node-fetch": "^3.3.2",
    "rimraf": "^5.0.0",
    "uuid": "^9.0.1",
    "dotenv": "^16.3.1",
    "promises": "^2.0.0",
    "async": "^3.2.2",
    "yargs": "^17.7.0",
    "c8": "^0.10.0",
    "nyc": "^15.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/jest": "^29.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "ts-jest": "^29.0.0",
    "husky": "^8.0.0",
    "lint-staged": "^13.0.0",
    "semantic-release": "^22.0.0",
    "@types/yargs": "^17.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md",
    "benchmarks",
    "cypress"
  ],
  "publishConfig": {
    "access": "public",
    "main": "dist/index.js",
    "module": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
      "dist/**/*",
      "README.md",
      "CHANGELOG.md",
      "benchmarks/**/*",
      "cypress/**/*"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:your-org/ai-air-drawing.git",
    "directory": "packages/testing"
  },
  "keywords": [
    "ai",
    "testing",
    "testing-framework",
    "unit-tests",
    "integration-tests",
    "performance",
    "benchmarking",
    "coverage",
    "e2e",
    "cypress",
    "jest",
    "test-automation"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/your-org/ai-air-drawing/issues",
    "email": "support@ai-air-drawing.com"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/your-org"
    }
  ],
  "contributors": [
    {
      "name": "Wimarsha Prudhvi",
      "email": "vimarshakprudhvi@domain.com",
      "url": "https://github.com/vimarshakprudhvi"
    }
  ]
}